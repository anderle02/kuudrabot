{
  "name": "kuudrabot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:gateway": "npm run dev --workspace=apps/gateway",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "prisma:generate": "prisma generate --schema=apps/worker/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=apps/worker/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=apps/worker/prisma/schema.prisma",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prisma": "^7.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.1": true
  }
}
